<Window x:Class="CybersecurityAwarenessBot_SA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🛡️ Cybersecurity Awareness Bot - South Africa" 
        Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E">

    <Window.Resources>
        <Style x:Key="ChatBubbleUser" TargetType="Border">
            <Setter Property="Background" Value="#4A90E2"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="10,5,80,5"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="MaxWidth" Value="500"/>
        </Style>

        <Style x:Key="ChatBubbleBot" TargetType="Border">
            <Setter Property="Background" Value="#2D2D3D"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="80,5,10,5"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="MaxWidth" Value="500"/>
        </Style>

        <Style x:Key="QuickTipButton" TargetType="Button">
            <Setter Property="Background" Value="#4A90E2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="30"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#6AAEE4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with ASCII Art -->
        <Border Grid.Row="0" Background="#2A2A3E" Padding="10" BorderBrush="#4A90E2" BorderThickness="0,0,0,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" FontFamily="Consolas" FontSize="8" 
                           Foreground="#00FFAA" TextAlignment="Center"
                           Text="╔════════════════════════════════════════════════════════════╗&#xD;&#xA;║                        ██████                              ║&#xD;&#xA;║                    ████████████                            ║&#xD;&#xA;║                  ██  ████████  ██                          ║&#xD;&#xA;║                 ██   ██████   ██                           ║&#xD;&#xA;║                 ██    ████    ██                           ║&#xD;&#xA;║                  ██   ████   ██                            ║&#xD;&#xA;║                   ██  ████  ██                             ║&#xD;&#xA;║                    ██████████                              ║&#xD;&#xA;║                      ██████                                ║&#xD;&#xA;║                        ██                                  ║&#xD;&#xA;║                🛡️  CYBER SHIELD ACTIVE  🛡️                ║&#xD;&#xA;║           Protecting South African Citizens Online         ║&#xD;&#xA;╚════════════════════════════════════════════════════════════╝"
                           TextWrapping="Wrap"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="ClearChatButton" Content="🗑️ Clear" Width="70" Height="35" 
                            Background="#FFA500" Foreground="White" FontWeight="Bold"
                            Click="ClearChatButton_Click" Cursor="Hand" Margin="5"/>
                    <Button x:Name="ExitButton" Content="❌ Exit" Width="70" Height="35" 
                            Background="#E94F4F" Foreground="White" FontWeight="Bold"
                            Click="ExitButton_Click" Cursor="Hand" Margin="5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Quick Tips Bar -->
        <Border Grid.Row="1" Background="#3A3A4E" Padding="5">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <Button Content="🔐 Passwords" Style="{StaticResource QuickTipButton}" Click="QuickTip_Click" Tag="password"/>
                    <Button Content="🎣 Phishing" Style="{StaticResource QuickTipButton}" Click="QuickTip_Click" Tag="phishing"/>
                    <Button Content="🔑 2FA" Style="{StaticResource QuickTipButton}" Click="QuickTip_Click" Tag="2fa"/>
                    <Button Content="📱 WhatsApp" Style="{StaticResource QuickTipButton}" Click="QuickTip_Click" Tag="whatsapp"/>
                    <Button Content="📶 Wi-Fi" Style="{StaticResource QuickTipButton}" Click="QuickTip_Click" Tag="wifi"/>
                    <Button Content="🇿🇦 SA Scams" Style="{StaticResource QuickTipButton}" Click="QuickTip_Click" Tag="sascams"/>
                    <Button Content="🔒 Privacy" Style="{StaticResource QuickTipButton}" Click="QuickTip_Click" Tag="privacy"/>
                    <Button Content="💡 Menu" Style="{StaticResource QuickTipButton}" Click="MenuTip_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Chat History Area -->
        <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="2" 
                      VerticalScrollBarVisibility="Auto"
                      Background="#1A1A2E">
            <StackPanel x:Name="ChatStackPanel" Margin="10" Orientation="Vertical"/>
        </ScrollViewer>

        <!-- Input Area -->
        <Border Grid.Row="3" Background="#2A2A3E" Padding="10" BorderBrush="#4A90E2" BorderThickness="0,2,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="InputTextBox" Grid.Column="0" 
                         FontSize="14" Padding="10" 
                         Background="White" Foreground="Black"
                         BorderBrush="#4A90E2" BorderThickness="2"
                         TextWrapping="Wrap" MinHeight="40"
                         KeyDown="InputTextBox_KeyDown"/>

                <Button x:Name="SendButton" Grid.Column="1" 
                        Content="📤 Send" Width="80" Height="40" Margin="5,0,0,0"
                        Background="#4A90E2" Foreground="White" FontWeight="Bold"
                        Click="SendButton_Click" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <StatusBar Grid.Row="4" Background="#1E1E2E">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Foreground="#888" 
                           Text="Ready to help you stay safe online! 🇿🇦"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="MemoryStatus" Foreground="#4A90E2" 
                           Text="📝 Memory: Active"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>